{
  "name": "claude-hamster",
  "displayName": "Hamster",
  "description": "Rich sidebar for hamster tmux Claude sessions \u2014 state board, jump, snooze, notes, PR decoration; you direct attention, it never does.",
  "version": "0.1.11",
  "publisher": "davidtedmanjones",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hamster",
          "title": "Hamster",
          "icon": "media/hamster.svg"
        }
      ]
    },
    "views": {
      "hamster": [
        {
          "type": "webview",
          "id": "hamsterWheel",
          "name": "Wheel"
        },
        {
          "type": "webview",
          "id": "hamsterNotes",
          "name": "Session Notes"
        }
      ]
    },
    "commands": [
      {
        "command": "hamster.refresh",
        "title": "Hamster: Refresh Wheel",
        "icon": "$(refresh)"
      },
      {
        "command": "hamster.attach",
        "title": "Hamster: Open Hamster Tab"
      },
      {
        "command": "hamster.prev",
        "title": "Hamster: Previous Session"
      },
      {
        "command": "hamster.jump",
        "title": "Hamster: Jump to Session\u2026"
      },
      {
        "command": "hamster.menu",
        "title": "Hamster: Command Menu\u2026",
        "icon": "$(list-unordered)"
      },
      {
        "command": "hamster.new",
        "title": "Hamster: New Session\u2026"
      },
      {
        "command": "hamster.adopt",
        "title": "Hamster: Adopt Sessions\u2026"
      },
      {
        "command": "hamster.snoozeActive",
        "title": "Hamster: Snooze Active Session\u2026"
      },
      {
        "command": "hamster.renameActive",
        "title": "Hamster: Rename Active Session\u2026"
      },
      {
        "command": "hamster.hidesnooze",
        "title": "Hamster: Toggle Hide-Snoozed"
      },
      {
        "command": "hamster.stepPrev",
        "title": "Hamster: Previous Window"
      },
      {
        "command": "hamster.stepNext",
        "title": "Hamster: Next Window"
      },
      {
        "command": "hamster.installCli",
        "title": "Hamster: Install CLI (hamster on PATH)"
      },
      {
        "command": "hamster.openSettings",
        "title": "Hamster: Settings",
        "icon": "$(gear)"
      },
      {
        "command": "hamster.row.pin",
        "title": "Pin / Unpin"
      },
      {
        "command": "hamster.row.snooze",
        "title": "Snooze\u2026"
      },
      {
        "command": "hamster.row.unsnooze",
        "title": "Unsnooze"
      },
      {
        "command": "hamster.row.rename",
        "title": "Rename (Pin Name)\u2026"
      },
      {
        "command": "hamster.row.ainame",
        "title": "AI-Name from Chat"
      },
      {
        "command": "hamster.row.addartifact",
        "title": "Add Artifact\u2026"
      },
      {
        "command": "hamster.row.restart",
        "title": "Restart Claude Process"
      },
      {
        "command": "hamster.row.close",
        "title": "Close Session\u2026"
      },
      {
        "command": "hamster.row.hibernate",
        "title": "Hibernate \u2014 Kill Process, Keep Session"
      }
    ],
    "keybindings": [
      {
        "command": "hamster.jump",
        "key": "f4",
        "when": "config.hamster.fkeys"
      },
      {
        "command": "hamster.jump",
        "key": "ctrl+alt+j"
      },
      {
        "command": "hamster.prev",
        "key": "ctrl+alt+p"
      },
      {
        "command": "hamster.attach",
        "key": "ctrl+alt+h"
      },
      {
        "command": "hamster.menu",
        "key": "f12",
        "when": "config.hamster.fkeys && terminalFocus"
      },
      {
        "command": "hamster.snoozeActive",
        "key": "f3",
        "when": "config.hamster.fkeys && terminalFocus"
      },
      {
        "command": "hamster.renameActive",
        "key": "f6",
        "when": "config.hamster.fkeys && terminalFocus"
      },
      {
        "command": "hamster.hidesnooze",
        "key": "f8",
        "when": "config.hamster.fkeys && terminalFocus"
      },
      {
        "command": "hamster.new",
        "key": "f11",
        "when": "config.hamster.fkeys && terminalFocus"
      },
      {
        "command": "hamster.stepPrev",
        "key": "f1",
        "when": "config.hamster.fkeys && terminalFocus"
      },
      {
        "command": "hamster.stepNext",
        "key": "f2",
        "when": "config.hamster.fkeys && terminalFocus"
      }
    ],
    "configuration": {
      "title": "Hamster",
      "properties": {
        "hamster.path": {
          "type": "string",
          "default": "",
          "description": "Path to the hamster script. Empty = automatic: existing Claude-hook wiring if present (e.g. a git-clone install), else the bundled core synced to ~/.claude/hamster/bin."
        },
        "hamster.terminalName": {
          "type": "string",
          "default": "hamster",
          "description": "Name of the integrated terminal that hosts (or will host) the tmux wheel client."
        },
        "hamster.terminalLocation": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "default": "editor",
          "description": "Where the wheel terminal is created: a full editor tab (default) or the terminal panel."
        },
        "hamster.pollMs": {
          "type": "number",
          "default": 1500,
          "description": "Wheel state poll interval in milliseconds."
        },
        "hamster.jiraBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Jira site for ticket chips; a ticket click opens <base>/browse/<KEY>. Empty disables."
        },
        "hamster.newSessionDir": {
          "type": "string",
          "default": "~",
          "description": "Default working directory offered when launching a new wheel session."
        },
        "hamster.fkeys": {
          "type": "boolean",
          "default": false,
          "description": "Bind F1\u2013F12 to hamster actions (F4 jump globally; F1/F2/F3/F6/F8/F11/F12 while a terminal is focused). Off by default because it shadows F-keys in terminal TUIs like htop."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "hamster.menu",
          "when": "view == hamsterWheel",
          "group": "navigation@1"
        },
        {
          "command": "hamster.openSettings",
          "when": "view == hamsterWheel",
          "group": "navigation@2"
        }
      ],
      "webview/context": [
        {
          "command": "hamster.row.pin",
          "when": "webviewSection == 'hamsterRow'",
          "group": "1_row@1"
        },
        {
          "command": "hamster.row.snooze",
          "when": "webviewSection == 'hamsterRow' && !hamsterSnoozed",
          "group": "1_row@2"
        },
        {
          "command": "hamster.row.unsnooze",
          "when": "webviewSection == 'hamsterRow' && hamsterSnoozed",
          "group": "1_row@3"
        },
        {
          "command": "hamster.row.rename",
          "when": "webviewSection == 'hamsterRow'",
          "group": "2_naming@1"
        },
        {
          "command": "hamster.row.ainame",
          "when": "webviewSection == 'hamsterRow'",
          "group": "2_naming@2"
        },
        {
          "command": "hamster.row.addartifact",
          "when": "webviewSection == 'hamsterRow'",
          "group": "3_facts@1"
        },
        {
          "command": "hamster.row.hibernate",
          "when": "webviewSection == 'hamsterRow' && !hamsterOff",
          "group": "4_danger@1"
        },
        {
          "command": "hamster.row.restart",
          "when": "webviewSection == 'hamsterRow'",
          "group": "4_danger@2"
        },
        {
          "command": "hamster.row.close",
          "when": "webviewSection == 'hamsterRow'",
          "group": "4_danger@3"
        }
      ],
      "commandPalette": [
        {
          "command": "hamster.row.pin",
          "when": "false"
        },
        {
          "command": "hamster.row.snooze",
          "when": "false"
        },
        {
          "command": "hamster.row.unsnooze",
          "when": "false"
        },
        {
          "command": "hamster.row.rename",
          "when": "false"
        },
        {
          "command": "hamster.row.ainame",
          "when": "false"
        },
        {
          "command": "hamster.row.addartifact",
          "when": "false"
        },
        {
          "command": "hamster.row.restart",
          "when": "false"
        },
        {
          "command": "hamster.row.close",
          "when": "false"
        },
        {
          "command": "hamster.row.hibernate",
          "when": "false"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidtedmanjones/claude-hamster"
  },
  "license": "MIT"
}