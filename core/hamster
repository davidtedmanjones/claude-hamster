#!/usr/bin/env bash
# Hamster — tmux-hosted Claude sessions, one per window, developer-directed.
# Tracks each session's state (working / needs-you / ready / snoozed) via
# Claude Code hooks; never moves your focus for you — you jump (F4, VS Code
# sidebar), it just keeps the board honest. tmux keeps every session's full
# history alive independent of any editor. Non-tmux Claude sessions self-skip.
set -uo pipefail
# overridable for hermetic tests (scripts/test.sh): state dir, transcript dir,
# and an isolated tmux server socket so tests never touch the real board
HDIR="${HAMSTER_DIR:-$HOME/.claude/hamster}"; mkdir -p "$HDIR"
PROJ="${HAMSTER_PROJECTS:-$HOME/.claude/projects}"
tmux(){ command tmux ${HAMSTER_SOCKET:+-L "$HAMSTER_SOCKET"} "$@"; }
SRC="${BASH_SOURCE[0]}"; [ -L "$SRC" ] && SRC="$(readlink "$SRC")"  # resolve the ~/.local/bin symlink to the repo
HERE="$(cd "$(dirname "$SRC")" && pwd)"
SELF="$HERE/hamster"
TS="${HAMSTER_TMUX_SESSION:-hamster}"
CLAUDE_CMD="${HAMSTER_CLAUDE_CMD:-claude --dangerously-skip-permissions}"

in_tmux(){ [ -n "${TMUX:-}" ] || [ -n "${HAMSTER_TARGET:-}" ]; }
cur_target(){
  # HAMSTER_TARGET: external UIs (VS Code sidebar) address any window without
  # a tmux client — every "current window" command becomes target-addressable
  if [ -n "${HAMSTER_TARGET:-}" ]; then printf '%s' "$HAMSTER_TARGET"; return; fi
  if [ -n "${TMUX_PANE:-}" ]; then
    tmux display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_index}' 2>/dev/null
  else
    tmux display-message -p '#{session_name}:#{window_index}' 2>/dev/null
  fi
}
kf(){ printf '%s/%s.json' "$HDIR" "$(printf '%s' "$1" | tr ':/ ' '___')"; }
set_sid_opt(){ [ -n "${2:-}" ] && tmux set-option -w -t "$1" @hamster_sid "${2:0:8}" 2>/dev/null; }
pinned_of(){ PF="$1" python3 -c "import json,os
try: print(json.load(open(os.environ['PF'])).get('pinned_name') or '')
except Exception: print('')"; }
clear_pin(){ CF="$1" python3 -c "import json,os
try:
 d=json.load(open(os.environ['CF'])); d.pop('pinned_name',None)
 t=os.environ['CF']+'.tmp'; json.dump(d,open(t,'w')); os.replace(t,os.environ['CF'])
except Exception: pass"; }

title_for(){  # sid cwd -> "label<TAB>turns": user alias > ai-title > 1st prompt;
  # turns = real user prompts, counted in the same full scan (no extra IO)
  python3 - "$1" "$2" "$PROJ" <<'PY'
import json,sys,os,glob,re
sid,cwd,proj=sys.argv[1],sys.argv[2],sys.argv[3]
alias=None
try:  # resurrect-names.json = the one user-given name store, shared with resurrect
    a=json.load(open(os.path.expanduser("~/.claude/resurrect-names.json")))
    if isinstance(a,dict) and a.get(sid): alias=" ".join(str(a[sid]).split())[:60]
except Exception: pass
tp=os.path.join(proj,re.sub(r'[/.]','-',cwd),sid+".jsonl")
if not os.path.exists(tp):                       # recorded cwd may differ from the project dir
    g=glob.glob(os.path.join(proj,"*",sid+".jsonl")); tp=g[0] if g else tp
title=first=None; turns=0
if os.path.exists(tp):
    for line in open(tp):
        try: d=json.loads(line)
        except: continue
        if d.get("type")=="ai-title" and d.get("aiTitle"): title=d["aiTitle"]
        elif d.get("type")=="user":
            m=d.get("message",{}); c=m.get("content")
            if isinstance(c,list): c=" ".join(x.get("text","") or "" for x in c if isinstance(x,dict))
            c=(c or "").strip().replace("\n"," ")
            if c and not c.startswith("<") and not c.startswith("["):
                turns+=1
                if first is None: first=c
lbl=alias or " ".join((title or first or ("session "+sid[:8])).split())[:60]
print("%s\t%d"%(lbl,turns))
PY
}

prune_dead(){  # drop queue entries whose tmux window no longer exists
  # a file that fails to parse is left alone — could be a torn concurrent
  # write, and deleting it would lose the session's sid/snooze/name
  local live; live=$(tmux list-windows -a -F '#{session_name}:#{window_index}' 2>/dev/null)
  LIVE="$live" python3 - "$HDIR" <<'PY' 2>/dev/null || true
import json,os,sys,glob
live=set((os.environ.get("LIVE","") or "").split())
for f in glob.glob(os.path.join(sys.argv[1],"*.json")):
    try: t=json.load(open(f)).get("target","")
    except Exception: continue
    if t and t not in live:
        try: os.remove(f)
        except Exception: pass
PY
}

load_conf(){  # render the keymap template (@HAMSTER@ -> this script) and source it
  HAM_BIN="$SELF" python3 - "$HERE/hamster.tmux.conf" "$HDIR/tmux.conf" <<'PY' 2>/dev/null || return 0
import os,sys
s=open(sys.argv[1]).read().replace("@HAMSTER@",os.environ["HAM_BIN"])
open(sys.argv[2],"w").write(s)
PY
  tmux source-file "$HDIR/tmux.conf" 2>/dev/null || true
}

snapshot_wheel(){  # persist the wheel roster to wheel-snapshot.json — keyed by sid, not window
  # index, so it survives a tmux-server death (reboot). 'heal' rebuilds from it.
  local wins; wins=$(tmux list-windows -t "$TS" -F '#{session_name}:#{window_index}	#{window_name}' 2>/dev/null) || return 0
  WINS="$wins" python3 - "$HDIR" <<'PY' 2>/dev/null || true
import json,os,sys,datetime
hdir=sys.argv[1]; out=[]
for row in (os.environ.get("WINS","") or "").splitlines():
    if "\t" not in row: continue
    tgt,name=row.split("\t",1)
    f=os.path.join(hdir,tgt.replace(":","_").replace("/","_").replace(" ","_")+".json")
    try: d=json.load(open(f))
    except Exception: continue
    sid=d.get("session_id") or ""
    if not sid and not d.get("pinned_name"): continue   # bare shells never heal
    out.append({"sid":sid,"cwd":d.get("cwd") or "","name":name,
                "pinned_name":d.get("pinned_name") or "",
                "returned_at":d.get("returned_at") or "","snooze_until":d.get("snooze_until") or ""})
tmp=os.path.join(hdir,".wheel-snapshot.tmp")
json.dump({"saved_at":datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None).isoformat()+"Z","windows":out},open(tmp,"w"))
os.replace(tmp,os.path.join(hdir,"wheel-snapshot.json"))
PY
}

case "${1:-}" in
  stop-hook)   # a session finished a turn -> enqueue it + refresh its label
    in_tmux || exit 0
    t=$(cur_target); [ -z "$t" ] && exit 0
    input="$(cat 2>/dev/null || true)"
    meta=$(printf '%s' "$input" | python3 -c "import json,sys
try: d=json.load(sys.stdin)
except: d={}
print((d.get('session_id') or '')+chr(9)+(d.get('cwd') or ''))" 2>/dev/null)
    sid="${meta%%$'\t'*}"; cwd="${meta#*$'\t'}"
    act=$(tmux display-message -p -t "${t%%:*}" '#{session_name}:#{window_index}' 2>/dev/null)
    HW_T="$t" HW_SID="$sid" HW_CWD="$cwd" HW_ACT="$act" python3 - "$(kf "$t")" <<'PY'
import json,os,sys,datetime
f=sys.argv[1]; d={}
if os.path.exists(f):
    try: d=json.load(open(f))
    except: d={}
d["target"]=os.environ["HW_T"]; d["state"]="returned"
d["returned_at"]=datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None).isoformat()+"Z"
d["attention"]=False; d["subagents"]=0   # turn finished -> clear pings + subagent count
# unread marker: cleared by the statusline reconciler once the response is
# plausibly SEEN — focused later (if unfocused now), or input/switch-away
# (if focused now, so a returned-while-away response stays green)
d["unseen"]=True
d["unseen_focus"]=(os.environ.get("HW_ACT","")==os.environ["HW_T"])
if os.environ.get("HW_SID"): d["session_id"]=os.environ["HW_SID"]
if os.environ.get("HW_CWD"): d["cwd"]=os.environ["HW_CWD"]
tmp=f+".tmp"; json.dump(d,open(tmp,"w")); os.replace(tmp,f)
PY
    [ -n "$sid" ] && set_sid_opt "$t" "$sid"
    if [ -n "$sid" ]; then
      out=$(title_for "$sid" "$cwd"); lbl="${out%%$'\t'*}"; trn="${out##*$'\t'}"
      [ -z "$(pinned_of "$(kf "$t")")" ] && [ -n "$lbl" ] && tmux rename-window -t "$t" "$lbl"
      case "$trn" in ''|*[!0-9]*) ;; *) HW_TRN="$trn" python3 - "$(kf "$t")" <<'PY'
import json,os,sys
f=sys.argv[1]
try: d=json.load(open(f))
except Exception: sys.exit(0)
d["turns"]=int(os.environ["HW_TRN"])
tmp=f+".tmp"; json.dump(d,open(tmp,"w")); os.replace(tmp,f)
PY
      ;; esac
    fi
    tmux set-option -w -t "$t" @hamster_state ready 2>/dev/null
    tmux set-option -wu -t "$t" @hamster_sub 2>/dev/null
    snapshot_wheel
    ;;
  submit-hook) # you submitted -> mark working, rotate to next returned
    in_tmux || exit 0
    cat >/dev/null 2>&1 || true
    t=$(cur_target); [ -z "$t" ] && exit 0
    HW_T="$t" python3 - "$(kf "$t")" <<'PY'
import json,os,sys
f=sys.argv[1]; d={}
if os.path.exists(f):
    try: d=json.load(open(f))
    except: d={}
d["target"]=os.environ["HW_T"]; d["state"]="working"; d["snooze_until"]=""
d["attention"]=False; d["subagents"]=0   # you answered / new turn -> clear pings + subagent count
d["unseen"]=False; d.pop("unseen_focus",None)
tmp=f+".tmp"; json.dump(d,open(tmp,"w")); os.replace(tmp,f)
PY
    tmux set-option -w -t "$t" @hamster_state working 2>/dev/null
    tmux set-option -wu -t "$t" @hamster_sub 2>/dev/null
    prune_dead
    snapshot_wheel
    ;;
  notify-hook) # Notification hook: Claude is asking / waiting -> flag the window for attention
    in_tmux || exit 0
    t=$(cur_target); [ -z "$t" ] && exit 0
    input="$(cat 2>/dev/null || true)"
    typ=$(printf '%s' "$input" | python3 -c "import json,sys
try: print((json.load(sys.stdin).get('notification_type') or '').lower())
except: print('')" 2>/dev/null)
    case "$typ" in
      permission_prompt|elicitation_dialog)   # only a real question/permission = needs you (NOT plain idle)
        HW_T="$t" python3 - "$(kf "$t")" <<'PY'
import json,os,sys
f=sys.argv[1]; d={}
if os.path.exists(f):
    try: d=json.load(open(f))
    except: d={}
d["target"]=os.environ["HW_T"]; d["attention"]=True
tmp=f+".tmp"; json.dump(d,open(tmp,"w")); os.replace(tmp,f)
PY
        tmux set-option -w -t "$t" @hamster_state attention 2>/dev/null
        ;;
    esac
    ;;
  subagent) # SubagentStart/Stop hook: adjust this window's running-subagent counter by $2 (+1/-1)
    in_tmux || exit 0
    cat >/dev/null 2>&1 || true
    delta="${2:-0}"; t=$(cur_target); [ -z "$t" ] && exit 0
    n=$(HW_T="$t" HW_D="$delta" python3 - "$(kf "$t")" <<'PY'
import json,os,sys
f=sys.argv[1]; d={}
if os.path.exists(f):
    try: d=json.load(open(f))
    except: d={}
d["target"]=os.environ["HW_T"]
n=int(d.get("subagents",0) or 0)+int(os.environ["HW_D"])
if n<0: n=0
d["subagents"]=n
tmp=f+".tmp"; json.dump(d,open(tmp,"w")); os.replace(tmp,f)
print(n)
PY
)
    if [ "${n:-0}" -gt 0 ] 2>/dev/null; then tmux set-option -w -t "$t" @hamster_sub "⚒$n" 2>/dev/null
    else tmux set-option -wu -t "$t" @hamster_sub 2>/dev/null; fi
    ;;
  prev)  # back to the session you were just on
    tmux last-window -t "$TS" 2>/dev/null || tmux display-message "Hamster: no previous window"
    ;;
  relabel)  # refresh every wheel window's name from its session title
    n=0
    for f in "$HDIR"/*.json; do
      [ -e "$f" ] || continue
      m=$(python3 - "$f" <<'PY'
import json,sys
try: d=json.load(open(sys.argv[1]))
except: sys.exit(0)
print((d.get("target") or "")+chr(9)+(d.get("session_id") or "")+chr(9)+(d.get("cwd") or ""))
PY
)
      tgt="${m%%$'\t'*}"; rest="${m#*$'\t'}"; sid="${rest%%$'\t'*}"; cwd="${rest#*$'\t'}"
      { [ -z "$tgt" ] || [ -z "$sid" ]; } && continue
      set_sid_opt "$tgt" "$sid"
      [ -n "$(pinned_of "$(kf "$tgt")")" ] && continue   # leave hardcoded names alone
      out=$(title_for "$sid" "$cwd"); lbl="${out%%$'\t'*}"
      [ -n "$lbl" ] && tmux rename-window -t "$tgt" "$lbl" 2>/dev/null && n=$((n+1))
    done
    echo "relabeled $n window(s)"
    ;;
  relabel-current)  # refresh just the current window's name from its AI title
    in_tmux || { echo "not in a tmux session"; exit 1; }
    t=$(cur_target); [ -z "$t" ] && exit 0
    m=$(python3 - "$(kf "$t")" <<'PY'
import json,sys
try: d=json.load(open(sys.argv[1]))
except: sys.exit(0)
print((d.get("session_id") or "")+chr(9)+(d.get("cwd") or ""))
PY
)
    sid="${m%%$'\t'*}"; cwd="${m#*$'\t'}"
    [ -z "$sid" ] && { tmux display-message "Hamster: no session id for this window yet"; exit 0; }
    clear_pin "$(kf "$t")"   # explicit relabel un-pins a hardcoded name
    out=$(title_for "$sid" "$cwd"); lbl="${out%%$'\t'*}"
    if [ -n "$lbl" ]; then
      tmux rename-window -t "$t" "$lbl"; set_sid_opt "$t" "$sid"
      tmux display-message "Hamster: relabeled -> $lbl"
    else tmux display-message "Hamster: no title found in transcript"; fi
    ;;
  ai-name)  # name current (or $2) window via an LLM reading the chat context (on-demand; fast model)
    in_tmux || { echo "not in a tmux session"; exit 1; }
    command -v claude >/dev/null 2>&1 || { tmux display-message "Hamster: claude not on PATH"; exit 0; }
    t="${2:-$(cur_target)}"; [ -z "$t" ] && exit 0
    meta=$(python3 - "$(kf "$t")" <<'PY'
import json,sys
try: d=json.load(open(sys.argv[1]))
except: sys.exit(0)
print((d.get("session_id") or "")+chr(9)+(d.get("cwd") or ""))
PY
)
    sid="${meta%%$'\t'*}"; cwd="${meta#*$'\t'}"
    [ -z "$sid" ] && { tmux display-message "Hamster: no session id for this window yet"; exit 0; }
    excerpt=$(SID="$sid" CWD="$cwd" python3 - "$PROJ" <<'PY'
import json,os,sys,glob,re
sid=os.environ["SID"]; cwd=os.environ["CWD"]; proj=sys.argv[1]
enc=lambda s: re.sub(r"[/.]","-",s)
tp=os.path.join(proj,enc(cwd),sid+".jsonl")
if not os.path.exists(tp):
    g=glob.glob(os.path.join(proj,"*",sid+".jsonl")); tp=g[0] if g else tp
msgs=[]
if os.path.exists(tp):
    for line in open(tp):
        try: d=json.loads(line)
        except: continue
        t=d.get("type")
        if t not in ("user","assistant"): continue
        c=d.get("message",{}).get("content")
        if isinstance(c,list): c=" ".join(x.get("text","") for x in c if isinstance(x,dict) and x.get("type")=="text")
        c=(c or "").strip().replace("\n"," ")
        if not c or c.startswith("<") or c.startswith("["): continue
        msgs.append(("User: " if t=="user" else "Asst: ")+c[:400])
sel=(msgs[:2]+msgs[-18:]) if len(msgs)>20 else msgs   # first asks + recent context
print("\n".join(sel)[:6000])
PY
)
    [ -z "$excerpt" ] && { tmux display-message "Hamster: no chat content to name from"; exit 0; }
    tmux display-message "Hamster: naming…"
    name=$(claude -p --model "${HAMSTER_NAME_MODEL:-claude-haiku-4-5}" --output-format text "Title this Claude Code session for a tmux tab. Reply with ONLY a concise 3-6 word title (no quotes, no punctuation, no trailing period) naming what the session is working on.

TRANSCRIPT:
$excerpt" 2>/dev/null | head -1 | tr -d '\"')
    name=$(printf '%s' "$name" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | cut -c1-60)
    if [ -n "$name" ]; then clear_pin "$(kf "$t")"; tmux rename-window -t "$t" "$name"; set_sid_opt "$t" "$sid"; tmux display-message "Hamster: named -> $name"
    else tmux display-message "Hamster: naming failed (no output from claude -p)"; fi
    ;;
  rename)  # hardcode (pin) the current window's name; auto-relabel won't overwrite it
    in_tmux || { echo "not in a tmux session"; exit 1; }
    t=$(cur_target); [ -z "$t" ] && exit 0
    name="${2:-}"
    [ -z "$name" ] && { tmux display-message "usage: hamster rename <name>"; exit 0; }
    tmux rename-window -t "$t" "$name"
    HW_T="$t" HW_N="$name" python3 - "$(kf "$t")" <<'PY'
import json,os,sys
f=sys.argv[1]; d={}
if os.path.exists(f):
    try: d=json.load(open(f))
    except: d={}
d["target"]=os.environ["HW_T"]; d["pinned_name"]=os.environ["HW_N"]
tmp=f+".tmp"; json.dump(d,open(tmp,"w")); os.replace(tmp,f)
sid=d.get("session_id")
if sid:  # name follows the SESSION, not the window: shared store with resurrect
    nf=os.path.expanduser("~/.claude/resurrect-names.json")
    try: a=json.load(open(nf))
    except Exception: a={}
    if not isinstance(a,dict): a={}
    a[sid]=os.environ["HW_N"]
    tmp=nf+".tmp"
    json.dump(a,open(tmp,"w"),indent=1); os.replace(tmp,nf)
PY
    tmux display-message "Hamster: 📌 pinned name -> $name (won't auto-relabel; prefix+r to unpin/AI-name)"
    ;;
  hidesnooze)  # toggle hiding snoozed windows from the window list (they reappear when the snooze ends)
    in_tmux || { echo "not in a tmux session"; exit 1; }
    if [ "$(tmux show-option -gv @hamster_hidesnooze 2>/dev/null)" = "1" ]; then
      tmux set-option -g @hamster_hidesnooze 0; tmux display-message "Hamster: snoozed windows shown"
    else
      tmux set-option -g @hamster_hidesnooze 1; tmux display-message "Hamster: 🙈 snoozed windows hidden (until snooze ends)"
    fi
    ;;
  step)  # F1/F2: move prev/next window by index; skips snoozed windows while they're hidden
    # Destination computed in one pass, single select-window. Never hop through
    # intermediate windows: visiting a snoozed one makes it active, and the tab-bar
    # hide filter exempts the active window -> hidden rows flash in and out.
    in_tmux || exit 0
    dir="${2:-next}"
    hide=$(tmux show-option -gv @hamster_hidesnooze 2>/dev/null)
    cur=$(tmux display-message -p -t "$TS" '#{window_index}')
    tgt=$(tmux list-windows -t "$TS" -F '#{window_index} #{@hamster_state}' | \
      awk -v cur="$cur" -v dir="$dir" -v hide="$hide" '
        {idx[++n]=$1; st[$1]=$2}
        END{
          for(i=1;i<=n;i++) if(idx[i]==cur) c=i
          for(s=1;s<n;s++){
            j=(dir=="next") ? ((c-1+s)%n)+1 : ((c-1-s+n)%n)+1
            w=idx[j]
            if(hide=="1" && st[w]=="snoozed") continue
            print w; exit
          }
        }')
    [ -n "$tgt" ] && tmux select-window -t "$TS:$tgt"
    ;;
  close)  # end current session: kill its window, clean queue, jump to next returned
    in_tmux || { echo "not in a tmux session"; exit 1; }
    t=$(cur_target); [ -z "$t" ] && exit 0
    prune_dead
    rm -f "$(kf "$t")"
    tmux kill-window -t "$t" 2>/dev/null
    snapshot_wheel
    ;;
  snooze)
    inc="${2:-}"; [ -z "$inc" ] && { echo "usage: hamster snooze <1m|5m|10m|15m|30m|1h|2h|4h|8h|1d|1w|forever>"; exit 1; }
    t=$(cur_target); [ -z "$t" ] && exit 0
    if [ "$inc" = forever ]; then
      until="9999-01-01T00:00:00Z"   # never expires under the lazy su>now check; cleared by unsnooze
    else
      until=$(python3 - "$inc" <<'PY'
import sys,re,datetime
m=re.match(r'^(\d+)([mhdw])$',sys.argv[1])
if not m: sys.exit(1)
u={'m':'minutes','h':'hours','d':'days','w':'weeks'}[m.group(2)]
print((datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)+datetime.timedelta(**{u:int(m.group(1))})).isoformat()+"Z")
PY
)
    fi
    [ -z "$until" ] && { echo "bad increment: $inc"; exit 1; }
    HW_T="$t" HW_SU="$until" python3 - "$(kf "$t")" <<'PY'
import json,os,sys,datetime
f=sys.argv[1]; d={}
if os.path.exists(f):
    try: d=json.load(open(f))
    except: d={}
d["target"]=os.environ["HW_T"]; d["state"]="returned"
d["snooze_until"]=os.environ["HW_SU"]
d.setdefault("returned_at", datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None).isoformat()+"Z")
tmp=f+".tmp"; json.dump(d,open(tmp,"w")); os.replace(tmp,f)
PY
    tmux set-option -w -t "$t" @hamster_state snoozed 2>/dev/null
    ;;
  unsnooze)  # clear a snooze on the current window; re-enters the ready queue, no rotation
    t=$(cur_target); [ -z "$t" ] && exit 0
    f=$(kf "$t")
    [ -f "$f" ] || { tmux display-message "Hamster: not on the wheel" 2>/dev/null; exit 0; }
    python3 - "$f" <<'PY'
import json,os,sys
f=sys.argv[1]
try: d=json.load(open(f))
except Exception: sys.exit(0)
d["snooze_until"]=""
tmp=f+".tmp"; json.dump(d,open(tmp,"w")); os.replace(tmp,f)
PY
    tmux set-option -w -t "$t" @hamster_state ready 2>/dev/null
    tmux display-message "Hamster: unsnoozed" 2>/dev/null
    ;;
  primary)  # set/clear this session's primary worktree — the sidebar leads with it
    t=$(cur_target); [ -z "$t" ] && exit 0
    sid=$(python3 - "$(kf "$t")" <<'PY'
import json,sys
try: print(json.load(open(sys.argv[1])).get("session_id") or "")
except Exception: print("")
PY
)
    [ -z "$sid" ] && { echo "no session id for this window yet"; exit 1; }
    val="${2:-}"
    [ -z "$val" ] && { echo "usage: hamster primary <path|clear>"; exit 1; }
    HP_SID="$sid" HP_VAL="$val" python3 - "$HDIR/worktrees.json" <<'PY'
import json,os,sys
f=sys.argv[1]; sid=os.environ["HP_SID"]; v=os.environ["HP_VAL"]
try: d=json.load(open(f))
except Exception: d={}
if v=="clear":
    d.pop(sid,None); print("primary cleared")
